'use client';
import React, { useState } from 'react';
import { Input } from '@/components/ui/input';
import { Checkbox } from '@/components/ui/checkbox';
import { Button } from '@/components/ui/button';
import { InputOTP, InputOTPGroup, InputOTPSeparator, InputOTPSlot } from '@/components/ui/input-otp';
import { toast } from 'sonner';
import axios from 'axios';
import { useRouter } from 'next/navigation';
import CartSummary from '@/app/components/checkout/CartSummary';
import useCartStore from '@/app/components/checkout/cartStore';

const AuthForm = () => {
  const router = useRouter();
  const [isSignUp, setIsSignUp] = useState(false);
  const [isOtpSent, setIsOtpSent] = useState(false);
  const [formData, setFormData] = useState({
    prefix: '',
    nom: '',
    prenom: '',
    email: '',
    password: '',
    newsletter: false,
  });
  const [otp, setOtp] = useState('');
  const [isLoading, setIsLoading] = useState(false);
  const { cart, getTotal, initCheckout } = useCartStore();

  const handleChange = (e) => {
    const { name, value, type, checked } = e.target;
    setFormData({
      ...formData,
      [name]: type === 'checkbox' ? checked : value,
    });
  };

  const handleSignUp = async (e) => {
    e.preventDefault();
    setIsLoading(true);

    try {
      const response = await axios.post('http://localhost:5000/auth/register', formData, {
        withCredentials: true,
      });
      toast.success(response.data.message, { duration: 5000 });
      setIsOtpSent(true);
    } catch (error) {
      toast.error(error.response?.data?.error || "Une erreur s'est produite. Veuillez réessayer.", { duration: 5000 });
    } finally {
      setIsLoading(false);
    }
  };

  const handleVerifyOtp = async (e) => {
    e.preventDefault();
    setIsLoading(true);

    try {
      const response = await axios.post(
        'http://localhost:5000/auth/verify-otp',
        {
          email: formData.email,
          otp,
        },
        {
          withCredentials: true,
        }
      );
      toast.success('OTP vérifié avec succès. Vous êtes maintenant connecté.', { duration: 5000 });
      router.push('/checkout/adresse');
    } catch (error) {
      toast.error(error.response?.data?.message || "Une erreur s'est produite. Veuillez réessayer.", { duration: 5000 });
    } finally {
      setIsLoading(false);
    }
  };

  const handleLogin = async (e) => {
    e.preventDefault();
    setIsLoading(true);

    try {
      const response = await axios.post(
        'http://localhost:5000/auth/login',
        {
          email: formData.email,
          password: formData.password,
        },
        {
          withCredentials: true,
        }
      );
      
      toast.success(response.data.message, { duration: 6000 });
      
      // Dispatch auth success event
      window.dispatchEvent(new CustomEvent('authChange', {
        detail: {
          authenticated: true,
          userPrenom: response.data.user?.prenom || ""
        }
      }));

      // After successful login, get the next step in checkout
      const nextStep = await initCheckout();
      router.push(nextStep);
    } catch (error) {
      toast.error(error.response?.data?.error || "Une erreur s'est produite. Veuillez réessayer.", { duration: 5000 });
    } finally {
      setIsLoading(false);
    }
  };

  const handlePrevious = () => {
    router.push('/checkout/cart'); 
  };

  return (
    <div className="flex w-full max-w-4xl mx-72 pl-8 gap-5">
      <div className="flex-1 max-w-lg">
        <div className="flex w-full justify-start space-x-2 relative mb-6">
          <button
            onClick={() => setIsSignUp(false)}
            className={`text-sm font-medium px-9 w-96 py-2 border ${!isSignUp ? 'border-black text-black' : 'border-gray-300 text-gray-500'}`}
          >
            DÉJÀ CLIENT ?
          </button>
          <button
            onClick={() => setIsSignUp(true)}
            className={`text-sm font-medium w-96 px-8 py-2 border ${isSignUp ? 'border-black text-black' : 'border-gray-300 text-gray-500'}`}
          >
            Nouveau client ?
          </button>
        </div>

        <div className="transition-all duration-300">
          {isOtpSent ? (
            <form onSubmit={handleVerifyOtp} className="space-y-4">
              <div className="w-64">
                <label className="block text-black font-medium mb-1 text-xs">
                  OTP <span className="text-yellow-500">*</span>
                </label>
                <InputOTP
                  maxLength={6}
                  value={otp}
                  onChange={(value) => setOtp(value)}
                  className="bg-white border border-black"
                >
                  <InputOTPGroup>
                    <InputOTPSlot index={0} />
                    <InputOTPSlot index={1} />
                    <InputOTPSlot index={2} />
                  </InputOTPGroup>
                  <InputOTPSeparator />
                  <InputOTPGroup>
                    <InputOTPSlot index={3} />
                    <InputOTPSlot index={4} />
                    <InputOTPSlot index={5} />
                  </InputOTPGroup>
                </InputOTP>
              </div>

              <div className="flex justify-between items-center mt-6">
                <Button
                  variant="outline"
                  onClick={handlePrevious}
                  className="text-xs rounded-none border border-black"
                >
                  Étape précédente
                </Button>
                <Button
                  type="submit"
                  className="text-xs rounded-none bg-black text-white border border-black hover:bg-white hover:text-black"
                  disabled={isLoading}
                >
                  {isLoading ? 'Chargement...' : 'Verify OTP'}
                </Button>
              </div>
            </form>
          ) : isSignUp ? (
            <form onSubmit={handleSignUp} className="space-y-4">
              <div className="w-full">
                <label className="block text-black font-medium mb-1 text-xs">
                  Civilité <span className="text-yellow-500">*</span>
                </label>
                <div className="flex items-center space-x-4">
                  <label className="flex items-center space-x-2">
                    <input
                      type="radio"
                      name="prefix"
                      value="Madame"
                      checked={formData.prefix === 'Madame'}
                      onChange={handleChange}
                      className="form-radio h-4 w-4 text-black rounded-sm focus:ring-black focus:border-white" />
                    <span className="text-xs text-black">Madame</span>
                  </label>
                  <label className="flex items-center space-x-2">
                    <input
                      type="radio"
                      name="prefix"
                      value="Monsieur"
                      checked={formData.prefix === 'Monsieur'}
                      onChange={handleChange}
                      className="form-radio h-4 w-4 text-black rounded-sm focus:ring-black focus:border-white" />
                    <span className="text-xs text-black">Monsieur</span>
                  </label>
                  <label className="flex items-center space-x-2">
                    <input
                      type="radio"
                      name="prefix"
                      value="MLLE"
                      checked={formData.prefix === 'MLLE'}
                      onChange={handleChange}
                      className="form-radio h-4 w-4 text-black rounded-sm focus:ring-black focus:border-white" />
                    <span className="text-xs text-black">MLLE</span>
                  </label>
                </div>
              </div>

              <div className="w-full">
                <label className="block text-black font-medium mb-1 text-xs">
                  Nom <span className="text-yellow-500">*</span>
                </label>
                <Input
                  type="text"
                  name="nom"
                  placeholder="Nom"
                  className="w-full text-xs bg-white border border-black rounded-none"
                  value={formData.nom}
                  onChange={handleChange}
                  required />
              </div>

              <div className="w-full">
                <label className="block text-black font-medium mb-1 text-xs">
                  Prénom <span className="text-yellow-500">*</span>
                </label>
                <Input
                  type="text"
                  name="prenom"
                  placeholder="Prénom"
                  className="w-full text-xs bg-white border border-black rounded-none"
                  value={formData.prenom}
                  onChange={handleChange}
                  required />
              </div>

              <div className="w-full">
                <label className="block text-black font-medium mb-1 text-xs">
                  Email <span className="text-yellow-500">*</span>
                </label>
                <Input
                  type="email"
                  name="email"
                  placeholder="Email"
                  className="w-full text-xs bg-white border border-black rounded-none"
                  value={formData.email}
                  onChange={handleChange}
                  required />
              </div>

              <p className="mt-1 text-xs text-black text-start">
                N&apos;oubliez pas de valider votre adresse e-mail.
              </p>

              <div className="w-full">
                <label className="block text-black font-medium mb-1 text-xs">
                  Mot de passe <span className="text-yellow-500">*</span>
                </label>
                <Input
                  type="password"
                  name="password"
                  placeholder="Mot de passe"
                  className="w-full text-xs bg-white border border-black rounded-none"
                  value={formData.password}
                  onChange={handleChange}
                  required />
              </div>

              <div className="flex items-center space-x-2 w-64">
                <Checkbox
                  id="newsletter"
                  name="newsletter"
                  checked={formData.newsletter}
                  onCheckedChange={(checked) => setFormData({ ...formData, newsletter: checked })}
                  className="bg-white border border-black rounded-none" />
                <label htmlFor="newsletter" className="text-xs text-black">
                  Je m&apos;inscris à la newsletter
                </label>
              </div>

              <div className="flex justify-between items-center mt-6">
                <Button
                  variant="outline"
                  onClick={handlePrevious}
                  className="text-xs rounded-none border border-black"
                >
                  Étape précédente
                </Button>
                <Button
                  type="submit"
                  className="text-xs rounded-none bg-black text-white border border-black hover:bg-white hover:text-black"
                  disabled={isLoading}
                >
                  {isLoading ? 'Chargement...' : "S'inscrire"}
                </Button>
              </div>
            </form>
          ) : (
            <form onSubmit={handleLogin} className="space-y-4">
              <div className="w-full">
                <label className="block text-black font-medium mb-2 text-xs">
                  Email <span className="text-yellow-500">*</span>
                </label>
                <Input
                  type="email"
                  name="email"
                  placeholder="Email"
                  className="w-full text-xs bg-white border border-black rounded-none"
                  value={formData.email}
                  onChange={handleChange}
                  required />
              </div>

              <div className="w-full">
                <label className="block text-black font-medium mb-2 text-xs">
                  Mot de passe <span className="text-yellow-500">*</span>
                </label>
                <Input
                  type="password"
                  name="password"
                  placeholder="Mot de passe"
                  className="w-full text-xs bg-white border border-black rounded-none"
                  value={formData.password}
                  onChange={handleChange}
                  required />
              </div>

              <div className="flex items-center justify-between w-full">
                <div className="flex items-center space-x-2">
                  <Checkbox id="remember" className="bg-white border border-black rounded-none" />
                  <label htmlFor="remember" className="text-xs text-black">
                    Rester connecté
                  </label>
                </div>
                <button
                  type="button"
                  className="text-xs text-blue-600 hover:underline"
                >
                  Mot de passe oublié ?
                </button>
              </div>

              <div className="flex justify-between items-center mt-6">
                <Button
                  variant="outline"
                  onClick={handlePrevious}
                  className="text-xs rounded-none border border-black"
                >
                  Étape précédente
                </Button>
                <Button
                  type="submit"
                  className="text-xs rounded-none bg-black text-white border border-black hover:bg-white hover:text-black"
                  disabled={isLoading}
                >
                  {isLoading ? 'Chargement...' : 'Se connecter'}
                </Button>
              </div>
            </form>
          )}
        </div>
      </div>
      
      <div className="hidden md:block">
        <CartSummary 
          showPromoCode={false}
          showCheckoutButton={false}
        />
      </div>
    </div>
  );
};

export default AuthForm;